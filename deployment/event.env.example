# Copy to deployment/event.env (ignored by Git). No shell interpolation is used.
# File paths below are relative to this file. Exported env overrides this file;
# explicit launcher flags override both. Empty credentials are never accepted.
OPERATION_MODE=event
APP_ENV=production
ALLOW_MOCK_HARDWARE=false
HOST_PROFILE=https
HOST_PORT=8000
HOST_BIND=127.0.0.1
HOST_TLS_HOST=localhost
# Supply trusted private TLS certificate/key, or explicitly configure a private
# HTTPS reverse proxy and set HOST_BEHIND_PROXY=true. No tunnel starts here.
HOST_BEHIND_PROXY=false
HOST_SSL_CERTFILE=
HOST_SSL_KEYFILE=
PUBLIC_BASE_URL=https://REPLACE_WITH_PUBLIC_HOSTNAME
PUBLIC_GATEWAY=true
PUBLIC_PORT=8001
OSA_STORAGE_ROOT=../runtime
OSA_FRONTEND_DIST=../frontend/dist-host
OSA_LOG_DIRECTORY=../runtime/logs
LOG_LEVEL=info
ADMIN_USERNAME=
ADMIN_PASSWORD=
BOOTH_PAIRING_KEY=
# Real vendor adapter remains BLOCKED until exact SDK/model/OS is implemented
# and tested. This example deliberately cannot claim physical readiness.
CAMERA_ADAPTER=vendor
CAMERA_MODEL=
CAMERA_GUEST_ENABLED=true
CAMERA_DEVICE_INDEX=0
CAMERA_TIMEOUT_SECONDS=15
CAMERA_LEASE_SECONDS=30
CAMERA_STALE_SECONDS=3
CAMERA_ALLOW_FAULTS=false
# Windows: windows. macOS/Linux with CUPS installed: cups.
PRINTER_MODE=windows
PRINTER_NAME=
MAX_PRINT_COPIES=3
# Set true only after printer/driver/paper selection and explicit approval to print.
ENABLE_PHYSICAL_PRINTING=false
CUPS_LP_COMMAND=lp
CUPS_LPSTAT_COMMAND=lpstat
GUEST_SESSION_IDLE_SECONDS=180
EVENT_GALLERY_POLL_SECONDS=5
MIN_FREE_SPACE_MB=512
OSA_MAX_UPLOAD_BYTES=10485760
OSA_MAX_IMAGE_PIXELS=24000000
ALLOW_LAN_HTTP=false
