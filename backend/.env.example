# Reference values; set these environment variables in PowerShell (not auto-loaded).
OSA_STORAGE_ROOT=../runtime
OSA_MAX_UPLOAD_BYTES=10485760
OSA_MAX_IMAGE_PIXELS=24000000
# Required to issue NEW share URLs; HTTPS public origin only, no localhost/private IP.
# Leave empty until you have an actual stable public origin. No tunnel deployment here.
PUBLIC_BASE_URL=
# Backend binds loopback by default; no public deployment in Phase 2.
