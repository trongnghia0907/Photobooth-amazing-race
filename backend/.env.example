# Reference values; set these environment variables in PowerShell (not auto-loaded).
OSA_STORAGE_ROOT=../runtime
OSA_MAX_UPLOAD_BYTES=10485760
OSA_MAX_IMAGE_PIXELS=24000000
# Safe default. Local QR requires APP_ENV=development and explicit localhost URL.
APP_ENV=production
# PUBLIC_BASE_URL=http://localhost:8000   # development only, THIS computer only
# Production still requires an actual HTTPS public origin. No automatic tunnel.
PUBLIC_BASE_URL=
PRINTER_MODE=mock
MAX_PRINT_COPIES=3
ENABLE_PHYSICAL_PRINTING=false
# Host camera: default synthetic Mock, never claims real shutter.
CAMERA_ADAPTER=mock
CAMERA_GUEST_ENABLED=false
CAMERA_DEVICE_INDEX=0
CAMERA_TIMEOUT_SECONDS=15
CAMERA_LEASE_SECONDS=30
CAMERA_STALE_SECONDS=3
CAMERA_ALLOW_FAULTS=false
# Optional: uvc_demo only in development, requires requirements-camera-optional.txt.
# Vendor SDK is intentionally blocked until model/SDK/device are confirmed.
# No default host account. Supply actual credentials through the environment.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Password must contain at least 12 characters. Local helper --admin prompts safely.
# Windows real printing: PRINTER_MODE=windows + ENABLE_PHYSICAL_PRINTING=true,
# then choose a driver printer in /admin. Never enable this in automated tests.
# Phase 6 launcher sets this to frontend/dist-host and requires a pairing key.
OSA_FRONTEND_DIST=
BOOTH_PAIRING_KEY=
# Minimum 16 characters. Keep secrets out of Git and terminal command arguments.
ALLOW_LAN_HTTP=false
# Only APP_ENV=development permits RFC1918 HTTP sharing with this explicit flag.
# run_host.py profiles set the appropriate same-origin defaults.
